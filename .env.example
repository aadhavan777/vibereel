# VibeReel Monorepo Environment Configuration Template

# FastAPI Backend Configuration
PROJECT_NAME=VibeReel
ENVIRONMENT=development
LOG_LEVEL=INFO
PORT=8000

# PostgreSQL Credentials
POSTGRES_USER=vibereel
POSTGRES_PASSWORD=vibereel_secure_password
POSTGRES_DB=vibereel_db
DATABASE_URL=postgresql://vibereel:vibereel_secure_password@localhost:5432/vibereel_db

# Security & JWT
SECRET_KEY=change_this_to_a_secure_random_64_character_hex_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Mobile API Gateway URLs
# Android Emulator -> 10.0.2.2:8000
# iOS Simulator -> localhost:8000
API_BASE_URL=http://localhost:8000/api/v1
